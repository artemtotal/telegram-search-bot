# Copy this file to .env and fill in local values.
# Never commit .env or real credentials.
BOT_TOKEN=replace_with_new_token_from_BotFather

# Housing subscription (all optional; defaults shown).
# Package prices in EUR: 1 month / 3 months / "until I find a flat" (one-off, 12 months technically).
# HOUSING_PRICE_M1_EUR=5
# HOUSING_PRICE_M3_EUR=12
# HOUSING_PRICE_UNTIL_FOUND_EUR=15
# 0 brings back the old 1-6 months picker (5 EUR a month).
# HOUSING_PACKAGES_ENABLED=1
# Personal numbers in the expiry warning / end-of-subscription message.
# HOUSING_PAY_REPORT_ENABLED=1
# Win-back message 7 days after the end + the gift (days, pause between gifts in days).
# HOUSING_WINBACK_ENABLED=1
# HOUSING_GIFT_DAYS=2
# HOUSING_GIFT_COOLDOWN_DAYS=90
# "Invite a friend" menu item, /start rf<code> links and the +1 month reward.
# HOUSING_REFERRAL_ENABLED=1
# "I found a flat" button (pause searches, keep the subscription).
# HOUSING_FOUND_ENABLED=1
# "Write in more detail" button after negative survey answers.
# HOUSING_SURVEY_MORE_ENABLED=1
